# Copy this file to `.env` (same directory) and edit before running
# `docker compose up`.

# Hostname that resolves to this server. Used both for the Traefik routing
# rule and for emission's --http.public-url.
EMISSION_HOST=emission.example.com

# Email Let's Encrypt sends expiry warnings to.
ACME_EMAIL=you@example.com

# Optional emission tunables. Defaults are reasonable; uncomment to override.
# EMISSION_CLIENT=qbittorrent-4.4.2
# EMISSION_MIN_SPEED=50K
# EMISSION_MAX_SPEED=500K
# EMISSION_MAX_RATIO=2.0
